#!/usr/bin/env python3
"""scripts/build-catalogue: regenerates research/references/README.md from _index/*.json.

The catalogue is generated so that it cannot drift from the dossiers. Stdlib only.
"""
import json
import re
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REF = ROOT / "research" / "references"
PROPS = ["functional", "safety", "liveness", "refinement", "symbolic_security", "computational_security", "parsing", "constant_time"]
MARK = {"proved": "PROVED", "tested": "tested", "assumed": "assumed", "partial": "partial", "no": "-", "n/a": "n/a",
        "yes": "Y(legacy)", "": "?", None: "?"}


def cell(v):
    return str(v).replace("|", "/").replace("\n", " ") if v not in (None, "") else "?"


rows = []
for j in sorted((REF / "_index").glob("REF-*.json")):
    d = json.loads(j.read_text(encoding="utf-8"))
    md = next(REF.glob(f"{d['id']}-*.md"), None)
    d["_file"] = md.name if md else None
    rows.append(d)

lean = [d for d in rows if d.get("kind") == "lean"]
comp = [d for d in rows if d.get("kind") != "lean"]
out = ["# Reference Catalogue", "",
       "Generated by `scripts/build-catalogue` from `_index/*.json`. Do not edit by hand.",
       "Each dossier is a factual scope review of prior work: what it claims, what it proves, how it reaches code, and what it trusts. None states a verdict on the hypothesis.",
       "", f"Dossiers: {len(rows)} ({len(lean)} Lean, {len(comp)} comparator).", ""]

for title, group in (("Lean 4 references", lean), ("Comparator references (other tools)", comp)):
    out += [f"## {title}", "", "| ID | Name | Subject | Tool | Maturity | Impl links (all) | Impl language | Evidence level | AI provenance | Built |", "|---|---|---|---|---|---|---|---|---|---|"]
    for d in group:
        name = f"[{cell(d.get('name'))}]({d['_file']})" if d["_file"] else cell(d.get("name"))
        links = ", ".join(d.get("impl_links") or [d.get("impl_link") or "?"])
        out.append(f"| {d['id']} | {name} | {cell(d.get('subject'))} | {cell(d.get('tool'))} | {cell(d.get('maturity'))} | {cell(links)} | {cell(d.get('impl_language'))} | {cell(d.get('evidence_level'))} | {cell(d.get('ai_provenance'))} | {cell(d.get('built'))} |")
    out.append("")

out += ["## Property coverage matrix", "", "Legend (review F-013): PROVED = machine-checked theorem; tested = established empirically only (testing, trace validation, bounded model checking); assumed = axiom or hypothesis; partial = proved for a strict subset; - = not addressed; n/a = not applicable; ? = not recorded; Y(legacy) = old yes/no value not yet reclassified. A cell describes what the reference establishes, not what Lean could do. Read the dossier's section 4 before citing a cell.", "",
        "| ID | " + " | ".join(PROPS) + " |", "|---|" + "---|" * len(PROPS)]
for d in rows:
    p = d.get("properties", {}) or {}
    out.append(f"| {d['id']} | " + " | ".join(MARK.get(str(p.get(k, "")).lower(), cell(p.get(k))) for k in PROPS) + " |")
out.append("")

out += ["## Implementation-link patterns", "", "The generalisation view: every mechanism each reference uses to reach running code. A reference with several mechanisms appears in several rows.", ""]
by = defaultdict(list)
for d in rows:
    for m in (d.get("impl_links") or [d.get("impl_link") or "?"]):
        by[cell(m)].append(d["id"])
out += ["| Mechanism | References |", "|---|---|"]
for k in sorted(by):
    out.append(f"| {k} | {', '.join(by[k])} |")
out.append("")

out += ["## Reusable patterns (from dossier section 11)", "", "| ID | Pattern |", "|---|---|"]
for d in rows:
    out.append(f"| {d['id']} | {cell(d.get('pattern'))} |")
out.append("")

out += ["## Trusted base summary", "", "| ID | sorry | axiom | native_decide | Unverified translator |", "|---|---|---|---|---|"]
for d in rows:
    t = d.get("tcb", {}) or {}
    out.append(f"| {d['id']} | {cell(t.get('sorry'))} | {cell(t.get('axiom'))} | {cell(t.get('native_decide'))} | {cell(t.get('unverified_translator'))} |")
out.append("")

out += ["## Sub-claim coverage", "", "| Sub-claim | References with relevant facts |", "|---|---|"]
sc = defaultdict(list)
for d in rows:
    for s in d.get("subclaims", []) or []:
        sc[s].append(d["id"])
for s in ["H1", "H2", "H3", "H4", "H5", "H5a", "H5b", "D"]:
    out.append(f"| {s} | {', '.join(sc.get(s, [])) or 'none'} |")
out.append("")

(REF / "README.md").write_text("\n".join(out), encoding="utf-8")
print(f"wrote research/references/README.md with {len(rows)} dossiers")
