#!/usr/bin/env python3
"""scripts/sync-issues: create missing labels and issues from docs/handoff/backlog.json.

Idempotent: issues are matched by exact title, and existing ones are never edited.
Writes docs/handoff/backlog.md with issue numbers and state.
Requires an authenticated `gh` CLI. Usage: scripts/sync-issues [--dry-run]
"""
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPEC = json.loads((ROOT / "docs" / "handoff" / "backlog.json").read_text(encoding="utf-8"))
DRY = "--dry-run" in sys.argv


def gh(*args):
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=True).stdout


existing_labels = {l["name"] for l in json.loads(gh("label", "list", "--limit", "200", "--json", "name"))}
for lab in SPEC["labels"]:
    if lab["name"] not in existing_labels:
        print(f"label + {lab['name']}")
        if not DRY:
            gh("label", "create", lab["name"], "--color", lab["color"], "--description", lab["description"])

issues = json.loads(gh("issue", "list", "--state", "all", "--limit", "500", "--json", "number,title,state,url"))
by_title = {i["title"]: i for i in issues}
rows = []
for it in SPEC["issues"]:
    cur = by_title.get(it["title"])
    if cur is None:
        print(f"issue + [{it['key']}] {it['title']}")
        if DRY:
            rows.append((it, "(dry-run)", "OPEN", ""))
            continue
        body = it["body"] + f"\n\n---\nBacklog key: `{it['key']}` (docs/handoff/backlog.json)."
        args = ["issue", "create", "--title", it["title"], "--body", body]
        for lab in it["labels"]:
            args += ["--label", lab]
        url = gh(*args).strip()
        cur = {"number": int(url.rsplit("/", 1)[-1]), "state": "OPEN", "url": url}
    rows.append((it, f"#{cur['number']}", cur["state"], cur["url"]))

out = ["# Backlog", "", "Generated by `scripts/sync-issues` from [backlog.json](backlog.json). GitHub issues are the live tracker. Edit backlog.json, then re-run the script.", "",
       "| Key | Issue | State | Labels | Title |", "|---|---|---|---|---|"]
for it, num, state, url in rows:
    link = f"[{num}]({url})" if url else num
    out.append(f"| {it['key']} | {link} | {state} | {', '.join(it['labels'])} | {it['title']} |")
if not DRY:
    (ROOT / "docs" / "handoff" / "backlog.md").write_text("\n".join(out) + "\n", encoding="utf-8")
print(f"{len(rows)} backlog items")
